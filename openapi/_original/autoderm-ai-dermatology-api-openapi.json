          "predictions"
        ],
        "title": "DiseaseModelResponse"
      },
      "DiseasePrediction": {
        "properties": {
          "disease": {
            "type": "string",
            "title": "Disease",
            "description": "Disease label, see disease catalog for details"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Prediction confidence score"
          },
          "icd_10": {
