        "required": [
          "icd_10",
          "categories",
          "en",
          "fr",
          "de",
          "it",
          "es",
          "sv",
          "zh"
        ],
        "title": "DiseaseCatalogEntry"
      },
      "DiseaseCatalogLocalizedEntry": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "simple_name": {
            "anyOf": [
