          "id": "a412e175-ea03-483d-8021-40b7a0fbfbda",
          "name": "Detect Blur",
          "request": {
            "name": "Detect Blur",
            "description": {
              "content": "Analyze an image to determine if it is blurry, using a configurable blur threshold.\n\nAnalyzes the image using the variance of the Laplacian method. Images with a variance below the specified threshold are considered blurry.\nUse this endpoint to automatically filter out low-quality, blurry images before further processing or model inference.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "utils",
                "detect-blur"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "threshold",
                  "value": "50",
                  "description": "The blur threshold. A value of 50 is recommended, which typically filters out the blurriest 30% of images."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Image file to upload. Maximum size: 10.00 MB. Minimum resolution: 224x224. Supported formats: JPEG, PNG, BMP, GIF, TIFF, PPM, PGM, PBM, WebP, DICOM."
                }
              ]
            }
          },
